# Copy to .env and fill in. Never commit .env.

# --- Agent B: Invoice Verification Specialist ---
AGENT_B_HOST=127.0.0.1
AGENT_B_PORT=10001
# Public base URL advertised in Agent B's Agent Card (default http://AGENT_B_HOST:AGENT_B_PORT)
# AGENT_B_PUBLIC_URL=http://127.0.0.1:10001

# --- Agent A: Procurement Coordinator ---
AGENT_A_HOST=127.0.0.1
AGENT_A_PORT=10002
# AGENT_A_PUBLIC_URL=http://127.0.0.1:10002
# Where Agent A discovers Agent B (base URL of Agent B's Agent Card)
AGENT_B_URL=http://127.0.0.1:10001
# How long Agent A waits for Agent B, in seconds
DELEGATION_TIMEOUT_SECONDS=30

# --- Shared ---
# Maximum accepted HTTP request body, in bytes
MAX_REQUEST_BYTES=262144
LOG_LEVEL=INFO

# --- Supabase review persistence (used by Agent B; backend only) ---
# Leave BOTH blank to run without persistence (each task then reports "disabled").
# SUPABASE_URL: Project Settings > Data API (https://<project-ref>.supabase.co)
# SUPABASE_SECRET_KEY: Project Settings > API Keys > secret key (sb_secret_...).
#   The legacy service_role JWT is also accepted. Publishable/anon keys are rejected.
#   Never put this key in frontend code or commit it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional request timeout in seconds (default 10)
# SUPABASE_TIMEOUT_SECONDS=10

# --- NexusAI API (FastAPI gateway for the frontend) ---
API_HOST=127.0.0.1
API_PORT=8080
# Where the API sends review requests (Agent A)
AGENT_A_URL=http://127.0.0.1:10002
# Browser origins allowed to call the API (comma-separated; e.g. VS Code Live Server, Vite)
API_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5173,http://localhost:5173
# How long the API waits for a full review (Agent A + Agent B), in seconds
API_REQUEST_TIMEOUT_SECONDS=120

# --- AI reasoning (Agent A; backend only) ---
# LLM_PROVIDER:
#   ollama      Ollama Cloud (recommended; works on a deployed server): OLLAMA_URL=https://ollama.com,
#               OLLAMA_API_KEY (from ollama.com/settings/keys), a free-tier cloud model such as
#               LLM_MODEL=gpt-oss:120b and optionally LLM_FALLBACK_MODEL=gemma4:31b.
#               Or local Ollama (offline, this machine only): leave OLLAMA_URL unset, ollama pull qwen2.5:3b
#   openai      any OpenAI-compatible API, e.g. Groq: LLM_BASE_URL=https://api.groq.com/openai/v1,
#               LLM_API_KEY=..., LLM_MODEL=llama-3.1-8b-instant
#   huggingface Hugging Face Inference Providers: HF_TOKEN (needs credits)
# Without a working model Agent A uses its built-in writer; reviews never fail because of the LLM.
LLM_PROVIDER=ollama
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
LLM_MODEL=gpt-oss:120b
LLM_FALLBACK_MODEL=gemma4:31b
# LLM_BASE_URL=
# LLM_API_KEY=
# HF_TOKEN=
# LLM_TIMEOUT_SECONDS=30   (default: 30 for hosted models, 60 for local Ollama)
# LLM_ENABLED=true

# --- OCR (scanned PDFs / images): path to tesseract.exe if it is not on PATH ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Real invoices from Kaggle (four open datasets; New review > Real invoices) ---
# Kaggle API token from kaggle.com > Settings > API. Secret: keep it on the server only.
# KAGGLE_API_KEY=
